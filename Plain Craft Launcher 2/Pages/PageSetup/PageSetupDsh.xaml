<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupDsh"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Margin="0,15" Title="运行环境状态">
                <Grid Margin="25,40,25,18">
                    <StackPanel>
                        <TextBlock x:Name="LabStatusNode" Text="正在检测……" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock x:Name="LabStatusDsh" Text="" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" />
                        <TextBlock x:Name="LabStatusRoot" Text="" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,8,0,0" />
                        <Grid Height="35" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton Grid.Column="0" x:Name="BtnInstallNode" MinWidth="150" Text="下载 Node.js" Padding="13,0" Margin="0,0,16,0" Click="InstallNode_Click" />
                            <local:MyButton Grid.Column="1" x:Name="BtnOpenDownload" MinWidth="150" Text="去下载 dsh 版本" Padding="13,0" Margin="0,0,16,0" Click="OpenDownload_Click" />
                            <local:MyButton Grid.Column="2" x:Name="BtnOpenFolder" MinWidth="150" Text="打开版本仓库" Padding="13,0" Click="OpenFolder_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="DSH 运行环境">
                <Grid Margin="25,40,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Node.js 位置" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextRuntimeRoot" Grid.Row="0" Grid.Column="1" local:SettingService.Key="DshRuntimeRoot"
                                     ToolTip="node.exe 所在目录。留空表示自动检测：&#xa;1. 启动器自带的 DSH\runtime\node\&#xa;2. 系统 PATH 中的 node"
                                     HintText="自动检测">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="dsh 本体位置" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextVersionRoot" Grid.Row="2" Grid.Column="1" local:SettingService.Key="DshVersionRoot"
                                     ToolTip="存放各个 dsh 版本的目录，每个版本一个子文件夹。留空表示启动器目录下的 DSH\versions\"
                                     HintText="默认：启动器目录\DSH\versions\">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="npm 下载源" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboNpmSource" Grid.Row="4" Grid.Column="1" local:SettingService.Key="DshNpmSource"
                                      ToolTip="安装 dsh 版本时使用的 npm 源">
                        <local:MyComboBoxItem Content="registry.npmjs.org（官方源）" />
                        <local:MyComboBoxItem Content="registry.npmmirror.com（国内镜像，推荐）" IsSelected="True" />
                    </local:MyComboBox>

                    <TextBlock Grid.Row="6" VerticalAlignment="Top" HorizontalAlignment="Left" Text="说明" Margin="0,6,25,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1" VerticalAlignment="Top" Margin="0,6,0,0" Opacity="0.6" TextWrapping="Wrap">
                        每个整合包都有自己独立的 DSH_HOME（技能、插件、配置、会话）与独立的 dsh 版本，互不影响。&#10;修改以上路径后需要重启启动器才能完全生效。
                    </TextBlock>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="启动行为">
                <Grid Margin="25,40,25,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="浏览器" Margin="0,0,25,0" />
                    <local:MyCheckBox Grid.Row="0" Grid.Column="1" x:Name="CheckAutoOpen" local:SettingService.Key="DshAutoOpenBrowser"
                                      Text="启动后自动用系统默认浏览器打开 DeepSeekHarness" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="退出启动器" Margin="0,0,25,0" />
                    <local:MyCheckBox Grid.Row="2" Grid.Column="1" x:Name="CheckStopOnExit" local:SettingService.Key="DshStopOnExit"
                                      Text="关闭启动器时一并结束由启动器启动的 dsh 进程"
                                      ToolTip="默认关闭：dsh 会继续在后台运行，浏览器刷新后仍可继续使用。" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="遥测" Margin="0,0,25,0" />
                    <local:MyCheckBox Grid.Row="4" Grid.Column="1" x:Name="CheckTelemetry" local:SettingService.Key="DshDisableTelemetry"
                                      Text="启动 dsh 时设置 DSH_TELEMETRY_DISABLED=1" />

                    <TextBlock Grid.Row="6" VerticalAlignment="Top" HorizontalAlignment="Left" Text="默认版本" Margin="0,6,25,0" />
                    <local:MyTextBox Grid.Row="6" Grid.Column="1" x:Name="TextDefaultVersion" local:SettingService.Key="DshDefaultVersion"
                                     HintText="内置推荐版本" ToolTip="新建整合包时默认绑定的 dsh 版本号，例如 0.1.7-rc.1。留空使用内置推荐版本。">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
