<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDshManager"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <local:MyCard Margin="0,15" Title="整合包">
                <Grid Margin="21,40,21,16">
                    <StackPanel>
                        <TextBlock Text="每个整合包拥有独立的 dsh 版本、插件、技能与配置（DSH_HOME），互不影响。"
                                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10" />
                        <local:MyComboBox x:Name="ComboInstance" SelectionChanged="ComboInstance_SelectionChanged" />
                        <Grid Height="35" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton Grid.Column="0" x:Name="BtnNew" MinWidth="120" Text="新建整合包" Padding="13,0" Margin="0,0,14,0" Click="New_Click" />
                            <local:MyButton Grid.Column="1" x:Name="BtnDelete" MinWidth="120" Text="删除整合包" Padding="13,0" Margin="0,0,14,0" Click="Delete_Click" />
                            <local:MyButton Grid.Column="2" x:Name="BtnOpenFolder" MinWidth="120" Text="打开目录" Padding="13,0" Margin="0,0,14,0" Click="OpenFolder_Click" />
                            <local:MyButton Grid.Column="3" x:Name="BtnLaunch" MinWidth="150" Text="启动 DeepSeekHarness" Padding="13,0" Margin="0,0,14,0" ColorType="Highlight" Click="Launch_Click" />
                            <local:MyButton Grid.Column="4" x:Name="BtnStop" MinWidth="120" Text="关闭 DSH" Padding="13,0" Click="Stop_Click" />
                        </Grid>
                        <TextBlock x:Name="LabInstanceInfo" Text="" TextWrapping="Wrap" FontSize="12" Opacity="0.65" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="插件">
                <Grid Margin="21,40,21,16">
                    <StackPanel>
                        <Grid Height="30" Margin="0,0,0,8">
                            <TextBlock x:Name="LabPluginInfo" Text="" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" Opacity="0.65" />
                            <local:MyButton x:Name="BtnPluginAdd" HorizontalAlignment="Right" MinWidth="140" Text="安装插件…" Padding="13,0" Click="PluginAdd_Click" />
                        </Grid>
                        <StackPanel x:Name="PanPlugins" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="技能">
                <Grid Margin="21,40,21,16">
                    <StackPanel>
                        <Grid Height="30" Margin="0,0,0,8">
                            <TextBlock x:Name="LabSkillInfo" Text="" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" Opacity="0.65" />
                            <local:MyButton x:Name="BtnSkillOpen" HorizontalAlignment="Right" MinWidth="140" Text="打开技能目录" Padding="13,0" Click="SkillOpen_Click" />
                        </Grid>
                        <StackPanel x:Name="PanSkills" />
                        <TextBlock Text="关闭技能 = 让 dsh 完全看不见它（改名 SKILL.md / 加 .disabled~ 前缀），随时可以再打开；dsh 正在运行时也立即生效。"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.55" Margin="13,10,13,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
